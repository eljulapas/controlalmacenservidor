<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".InventarioActivity">


    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
                  android:layout_width="match_parent"
                  android:layout_height="match_parent"
                  android:orientation="vertical"
                  android:padding="12dp">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

            <Button android:id="@+id/btn_todos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Todos"/>

            <Button android:id="@+id/btn_bajo_stock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Stock Bajo"/>

            <Button android:id="@+id/btn_deshabilitados"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Deshabilitados"/>


        </LinearLayout>

        <Button
                android:id="@+id/btn_atras"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Atrás"
                android:layout_marginTop="8dp" />

        <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_inventario"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"/>

        <Button android:id="@+id/btn_enviar_correo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Enviar Inventario por Correo"/>
    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>